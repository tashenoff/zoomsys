# ============================================
# ENV для ЛОКАЛЬНОЙ разработки
# Для production на VPS используйте .env.production.example
# ============================================

# API URL для фронтенда (только для локальной разработки)
VITE_API_URL=http://localhost:3001/api

# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoomsys

# JWT Secret (измените на продакшене!)
JWT_SECRET=your-secret-key-here-change-in-production
