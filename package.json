{
  "name": "zoomsys",
  "version": "1.0.0",
  "type": "module",
  "description": "CRM система для типографии ZoomSys",
  "main": "server/index.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "heroku-postbuild": "npm run build && cd server && npm install",
    "migrate": "cd server && npm run migrate",
    "seed": "cd server && npm run seed"
  },
  "keywords": [
    "crm",
    "printing",
    "heroku"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.4"
  }
}
